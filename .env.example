# Application
NODE_ENV=development # development | test | production
PORT=3000 # HTTP port for the application
HOST=127.0.0.1 # Bind address for local development
LOG_LEVEL=info # debug | info | warn | error

# PostgreSQL / Prisma
# Use a local development database. Never commit real credentials.
DATABASE_URL=postgresql://app_user:change_me@localhost:5432/ai_kms_dev?schema=public

# Authentication
# Replace with a locally generated random value in .env.
AUTH_SECRET=replace_with_a_local_random_secret
AUTH_SESSION_TTL_SECONDS=86400

# AI provider
# Placeholder only; add a real key through the deployment secret manager.
LLM_PROVIDER=mock
LLM_MODEL=replace_with_approved_model
LLM_API_KEY=replace_with_provider_key
LLM_BASE_URL=https://api.example.invalid/v1
LLM_TIMEOUT_MS=15000

# AI safety and retrieval
AI_ALLOW_INTERNET=false
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0
SEARCH_INDEX_URL=http://localhost:7700

# Audit and observability
AUDIT_LOG_LEVEL=info
CORRELATION_ID_HEADER=x-correlation-id

# Optional external notifications
NOTIFICATION_PROVIDER=disabled
NOTIFICATION_API_KEY=replace_with_notification_key
